# Copy this file to .env and replace every value with your own.
SENDER_NAME=YOUR FULL NAME
RESUME_FILE=resume.pdf
SEED_ADDRESSES=
SEED_POSITIONS=1,20,40

GMAIL_ACCOUNT_1_EMAIL=your.account@gmail.com
GMAIL_ACCOUNT_1_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_ACCOUNT_1_DAILY_CAP=370

